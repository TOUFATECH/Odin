{
  "name": "agora-poste",
  "productName": "Agora",
  "version": "0.1.1",
  "description": "Agora, le store d'Odin sur ton ordinateur : les applis auxquelles tu as droit, installées et tenues à jour.",
  "license": "MIT",
  "author": { "name": "TOUFATECH", "email": "contact@toufatech.com" },
  "homepage": "https://github.com/TOUFATECH/Odin#readme",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/construire.mjs",
    "types": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.toufatech.agora",
    "productName": "Agora",
    "copyright": "TOUFATECH — licence MIT",
    "directories": { "output": "sortie", "buildResources": "build" },
    "files": ["dist/**/*", "package.json"],
    "asar": true,
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icones",
      "executableName": "agora",
      "synopsis": "Le store d'Odin",
      "maintainer": "TOUFATECH <contact@toufatech.com>",
      "artifactName": "Agora-${version}-${arch}.${ext}",
      "desktop": { "entry": { "Name": "Agora", "Comment": "Le store d'Odin", "StartupWMClass": "agora" } }
    },
    "deb": { "depends": ["libsecret-1-0"], "packageName": "agora-odin" },
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "signAndEditExecutable": true, "artifactName": "Agora-${version}-Installation.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Agora", "installerIcon": "build/icon.ico", "uninstallerIcon": "build/icon.ico" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities", "icon": "build/icon.png", "artifactName": "Agora-${version}-${arch}.${ext}" }
  }
}
