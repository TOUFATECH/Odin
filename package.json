{
  "name": "odin-agent",
  "version": "0.28.1",
  "description": "Odin — agent IA personnel, auto-apprenant et sûr par défaut : interface web, Telegram, inventaire du réseau, décisions transparentes.",
  "type": "module",
  "license": "MIT",
  "author": "TOUFATECH",
  "repository": { "type": "git", "url": "https://github.com/TOUFATECH/Odin.git" },
  "homepage": "https://github.com/TOUFATECH/Odin#readme",
  "keywords": ["agent", "ia", "assistant", "telegram", "securite", "auto-hebergement"],
  "bin": {
    "odin": "bin/odin.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "odin": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
