    <style name="Theme.Agora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nuit</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="fond_agora">#FFEEF8F9</color>
    <color name="nuit">#FF000000</color>
    <color name="agora_sarcelle">#FF0B7F7C</color>
</resources>
