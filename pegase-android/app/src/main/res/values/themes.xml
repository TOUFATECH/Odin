<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Le noir du ciel étoilé dès l'ouverture : le premier écran (lancement) est sur la nuit étoilée. -->
    <style name="Theme.Pegase" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fond_pegase</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="fond_pegase">#FF000000</color>
    <color name="pegase_violet">#FF7F00FF</color>
</resources>
