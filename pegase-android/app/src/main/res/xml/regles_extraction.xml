<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé par Google : les fichiers de Pégase sont chiffrés par une clé qui ne quitte pas
     le téléphone ; tout revient d'Odin à la reconnexion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
