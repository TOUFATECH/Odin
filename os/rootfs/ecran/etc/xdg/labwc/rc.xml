<?xml version="1.0"?>
<!-- Odin OS — labwc : la vue du bureau occupe tout l'écran, sans bordure, et reste derrière les applis à fenêtre
     (applis Linux, applis Windows via Wine) qui s'ouvrent par-dessus avec leur barre de titre. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>10</cornerRadius>
    <font name="sans" size="11" />
  </theme>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>
  <windowRules>
    <windowRule identifier="os.odin.Vue" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes">
      <action name="Maximize" />
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>
  <keyboard>
    <default />
  </keyboard>
  <mouse>
    <default />
  </mouse>
</labwc_config>
