{
  "name": "pegase",
  "productName": "Pégase",
  "version": "0.1.0",
  "description": "Pégase, le navigateur d'Odin : léger, protégé, synchronisé avec ton Odin.",
  "license": "MIT",
  "author": {
    "name": "TOUFATECH",
    "email": "contact@toufatech.com"
  },
  "homepage": "https://github.com/TOUFATECH/Odin#readme",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "icones": "node scripts/icones.mjs",
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').copyFileSync('src/main/odin-sso.mjs','dist/main/odin-sso.mjs')\"",
    "build:ui": "vite build",
    "build": "npm run icones && npm run build:main && npm run build:ui",
    "types": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "electron .",
    "test": "xvfb-run -a node --test --test-concurrency=1 test/*.test.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "tldts-experimental": "7.5.2",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.toufatech.pegase",
    "productName": "Pégase",
    "executableName": "pegase",
    "artifactName": "Pegase-${version}-${os}-${arch}.${ext}",
    "copyright": "© TOUFATECH — licence MIT",
    "directories": {
      "output": "paquets",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icone.png",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "protocols": [
      {
        "name": "Pages web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TOUFATECH",
        "repo": "Odin",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Le navigateur d'Odin",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ],
      "desktop": {
        "entry": {
          "Name": "Pégase",
          "Comment": "Le navigateur d'Odin",
          "StartupWMClass": "Pégase"
        }
      }
    },
    "deb": {
      "packageName": "pegase"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "shortcutName": "Pégase",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Pégase ${version}"
    }
  }
}
